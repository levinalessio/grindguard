    else
        printf 'Stimme:              keine deutsche Stimme gefunden – es spricht die Standardstimme.\n'
        printf '                     (Nachladen: Systemeinstellungen > Bedienungshilfen > Gesprochene Inhalte > Systemstimme)\n'
    fi
    printf 'Listen:              %s Websites, %s Apps, %s Suchbegriffe blockiert\n' "$(count_lines "$SITES_BLOCK")" "$(count_lines "$APPS_BLOCK")" "$(count_lines "$SEARCH_BLOCK")"

    for f in "/Applications/Firefox.app" "$HOME/Applications/Firefox.app" "/Applications/Zen.app" "/Applications/Zen Browser.app" "/Applications/LibreWolf.app"; do
        if [ -d "$f" ]; then
            printf 'Achtung:             %s gefunden. Firefox-Browser lassen sich nicht mitlesen –\n' "$f"
            printf '                     Websites dort werden NICHT erkannt. Entweder Safari/Chrome nutzen\n'
            printf '                     oder den Browser in apps.txt eintragen (dann wird er ganz geschlossen).\n'
        fi
    done

    # Am aussagekräftigsten ist der aktuelle Zustand des laufenden Wächters (status.txt).
    # Ein Test aus dem Terminal würde die Erlaubnis des Terminals prüfen, nicht die des Dienstes.
    browsers=""
    denied=""
    if daemon_pid; then
        browsers=$(status_value browser_ok)
        denied=$(status_value browser_ohne_erlaubnis)
    fi
    if [ -z "$browsers" ] && [ -f "$LOG" ]; then
        browsers=$(sed -n 's/^.*Browser-Zugriff ok: //p' "$LOG" | sort -u | tr '\n' ',' | sed -e 's/,$//' -e 's/,/, /g')
    fi
    trim "$denied"; denied=$REPLY
    if [ -n "$denied" ]; then
        printf 'Browser-Erlaubnis:   FEHLT gerade für %s\n' "$denied"
        ok=0
    fi
    if [ -n "$browsers" ]; then
        printf 'Browser-Erlaubnis:   erteilt für %s\n' "$browsers"
    else
        printf 'Browser-Erlaubnis:   noch nicht bestätigt – öffne Safari oder Chrome einmal, während der Wächter läuft.\n'
    fi
    if [ -f "$LOG" ] && grep -q 'KEINE ERLAUBNIS' "$LOG" 2>/dev/null; then
        printf '\nErlaubnis fehlt(e) – letzter Eintrag:\n'
        grep 'KEINE ERLAUBNIS' "$LOG" | tail -n 1 | sed 's/^/  /'
        printf '  Beheben: Systemeinstellungen > Datenschutz & Sicherheit > Automation,\n'
        printf '  dort bei "bash" bzw. "osascript" den Browser einschalten.\n'
        printf '  Steht dort kein Eintrag: im Terminal "tccutil reset AppleEvents" eingeben\n'
        printf '  (setzt alle solchen Rückfragen zurück), danach: %s/grind start\n' "$BASE"
        ok=0
    fi
    if [ -f "$LOG" ] && grep -q 'FEHLER' "$LOG" 2>/dev/null; then
        printf '\nLetzte Fehler im Protokoll (%s):\n' "$LOG"
        grep 'FEHLER' "$LOG" | tail -n 3 | sed 's/^/  /'
    fi

    printf '\n'
    if [ "$ok" != 1 ]; then
        echo "Es gibt Punkte zu beheben (siehe oben)."
    elif [ -z "$browsers" ]; then
        echo "Fast fertig: Öffne jetzt einmal deinen Browser. macOS fragt dann, ob er gesteuert"
        echo "werden darf (einmal pro Browser) – mit \"Erlauben\" bestätigen. Ohne dieses OK"
        echo "kann GrindGuard dort keine Websites sehen."
    else
        echo "Alles in Ordnung."
    fi
}

usage() {
    cat <<EOF
GrindGuard $VERSION – dein Fokus-Wächter

  grind status        Läuft der Wächter? Wie viele Ausrutscher heute?
  grind fokus [Min]   Fokus-Sitzung (Standard 50): Listen eingefroren, keine Pause
  grind notausstieg   Fokus-Sitzung vorzeitig beenden (mit 10 Minuten Wartezeit)
  grind pause [Min]   Bewusste Pause (Standard 15, maximal 120 Minuten)
  grind weiter        Pause sofort beenden
  grind test          Warnung einmal zur Probe anzeigen
  grind stats         Ausrutscher der letzten 7 Tage
  grind edit          Blocklisten, Sprüche und Einstellungen öffnen
  grind check ADRESSE Zeigt, ob eine Website oder Suche blockiert würde – und welche Regel
  grind doctor        Prüfen, ob alles richtig eingerichtet ist
  grind start         Wächter starten (danach automatisch bei jeder Anmeldung)
  grind stop          Wächter anhalten (bis zur nächsten Anmeldung)
  grind uninstall     Wächter entfernen

Aufruf im Terminal:  $BASE/grind <Befehl>
EOF
}

case ${1:-help} in
    run)            daemon ;;
    start)          cmd_start ;;
    stop)           cmd_stop ;;
    uninstall)      cmd_uninstall ;;
    status)         cmd_status ;;
    pause)          cmd_pause "$2" ;;
    weiter|resume)  cmd_resume ;;
    test)           cmd_test ;;
    stats)          cmd_stats ;;
    edit)           cmd_edit ;;
    check|explain)  cmd_check "$2" ;;
    fokus|focus)    cmd_fokus "$2" ;;
    notausstieg)    cmd_notausstieg ;;
    __corpus)       cmd_corpus "$2" ;;
    doctor)         cmd_doctor ;;
    help|-h|--help) usage ;;
    *)              usage; exit 1 ;;
esac
