rule_lines() {   # wirksame Zeilen der Website-Liste: "Zeile<TAB>Eintrag" (wie load_sites vereinheitlicht)
    [ -f "$SITES_FILE" ] || return 0
    LC_ALL=C tr -d '\r' < "$SITES_FILE" 2>/dev/null | LC_ALL=C tr '[:upper:]' '[:lower:]' |
        LC_ALL=C sed -E -e 's/#.*$//' -e 's/^[[:space:]]+//' -e 's/[[:space:]]+$//' \
               -e 's/^[+][[:space:]]+/+/' \
               -e 's|^([+]?)https?://|\1|' -e 's|^([+]?)www[.]|\1|' -e 's|/+$||' |
        LC_ALL=C awk 'length($0) > 0 { printf "%d\t%s\n", NR, $0 }'
}

find_rule() {   # $1 = allow | search | block; setzt R_LINE und R_TEXT für die erste passende Zeile
    local nr e k
    R_LINE=""
    R_TEXT=""
    while IFS='	' read -r nr e; do
        [ -n "$e" ] || continue
        case $1 in
            allow)
                case $e in
                    +*) site_match "${e#+}" || continue ;;
                    *) continue ;;
                esac ;;
            search)
                case $e in
                    suche:*) k=${e#suche:}; trim "$k"; [ "$REPLY" = "$S_HIT" ] || continue ;;
                    *) continue ;;
                esac ;;
            block)
                case $e in
                    +*|suche:*) continue ;;
                esac
                site_match "$e" || continue ;;
        esac
        R_LINE=$nr
        R_TEXT=$e
        return 0
    done <<EOF
$(rule_lines)
EOF
    return 1
}

cmd_check() {   # $1 = Adresse; zeigt, ob sie blockiert würde, und welche Regel greift
    local u where f
    [ -n "$1" ] || die "Aufruf: grind check youtube.com/shorts"
    STIMMEN_NAME=""; VOICE_PICKED=1
    f=$(focus_end_file) && [ "$(date +%s)" -lt "$f" ] && [ -d "$FOCUS_DIR" ] && set_conf_src "$FOCUS_DIR"
    load_all
    case $1 in
        *://*) u=$1 ;;
        *)     u="https://$1" ;;
    esac
    if ! parse_url "$u"; then
        echo "Das ist keine Webadresse: $1"
        return 1
    fi
    where="websites.txt"
    [ "$CONF_SRC" = "$FOCUS_DIR" ] && where="eingefrorene Liste der Fokus-Sitzung"
    if site_blocked; then
        if [ -n "$S_HIT" ]; then
            # shellcheck disable=SC1111
            echo "BLOCKIERT  $U_HOST$U_PATH  (Suchbegriff „$S_HIT“)"
            find_rule search && printf '  Regel:    %s  (%s, Zeile %s)\n' "$R_TEXT" "$where" "$R_LINE"
        else
            echo "BLOCKIERT  $U_HOST$U_PATH"
            find_rule block && printf '  Regel:    %s  (%s, Zeile %s)\n' "$R_TEXT" "$where" "$R_LINE"
        fi
    else
        echo "erlaubt    $U_HOST$U_PATH"
        if find_rule allow; then
            printf '  Ausnahme: %s  (%s, Zeile %s)\n' "$R_TEXT" "$where" "$R_LINE"
        fi
    fi
}

cmd_corpus() {  # für die automatischen Tests: eine Adresse pro Zeile -> "B <Suchbegriff|->" oder "E -"
    local line
    [ -f "$1" ] || die "Datei fehlt: $1"
    STIMMEN_NAME=""; VOICE_PICKED=1
    load_all
    while IFS= read -r line || [ -n "$line" ]; do
        line=$(printf '%s' "$line" | tr -d '\r')
        case $line in
            ''|'#'*) continue ;;
        esac
        case $line in
            *://*) ;;
            *) line="https://$line" ;;
        esac
        if parse_url "$line" && site_blocked; then
            printf 'B %s\n' "${S_HIT:--}"
        else
            printf 'E -\n'
        fi
    done < "$1"
}

cmd_fokus() {   # $1 = Minuten (Standard 50, 5 bis 240)
    local min now end cur f
    min=${1:-50}
    if ! is_small_int "$min" || [ "$min" -lt 5 ]; then
        die "Bitte die Minuten als Zahl angeben (5 bis 240), z. B.: grind fokus 50"
    fi
    if [ "$min" -gt 240 ]; then
        min=240
        echo "Maximal 240 Minuten am Stück."
    fi
    mkdir -p "$STATE_DIR" || die "Kann $STATE_DIR nicht anlegen."
    now=$(date +%s)
    end=$((now + min * 60))
    cur=$(focus_end_file)
    if [ -n "$cur" ] && [ "$now" -lt "$cur" ]; then
        if [ "$end" -le "$cur" ]; then
            echo "Es läuft schon eine Fokus-Sitzung bis $(clock "$cur") Uhr. Verkürzen geht nicht."
            return 0
        fi
        echo "Fokus-Sitzung verlängert."
    else
        rm -rf "$FOCUS_DIR"
        mkdir -p "$FOCUS_DIR" || die "Kann $FOCUS_DIR nicht anlegen."
        for f in einstellungen.txt websites.txt apps.txt sprueche.txt; do
            [ -f "$CONF_DIR/$f" ] && cp "$CONF_DIR/$f" "$FOCUS_DIR/$f"
        done
    fi
    printf '%s\n' "$end" > "$FOCUS_FILE"
    rm -f "$PAUSE_FILE"
    log "Fokus-Sitzung gestartet: $min Minuten, bis $(clock "$end") Uhr"
    echo "Fokus-Sitzung: $min Minuten, bis $(clock "$end") Uhr."
    echo "Deine Listen sind bis dahin eingefroren, pause, stop und uninstall sind gesperrt."
    echo "Notausstieg (10 Minuten Wartezeit): $BASE/grind notausstieg"
    if ! daemon_pid; then
        echo "Achtung: Der Wächter läuft gerade nicht – starten mit: $BASE/grind start"
    fi
}

cmd_notausstieg() {
    local cur now line end
    cur=$(focus_end_file)
    now=$(date +%s)
    if [ -z "$cur" ] || [ "$now" -ge "$cur" ]; then
        echo "Es läuft keine Fokus-Sitzung."
        return 0
    fi
    if [ ! -t 0 ] && [ -z "${GRIND_TEST_TTY:-}" ]; then
        die "Der Notausstieg geht nur von Hand im Terminal."
    fi
    echo "Die Sitzung läuft noch bis $(clock "$cur") Uhr."
    echo "Wenn du wirklich aussteigen willst, tippe genau diesen Satz ab und drück Enter:"
    echo
    echo "  $NOT_SATZ"
    echo
    line=""
    IFS= read -r line
    if [ "$line" != "$NOT_SATZ" ]; then
        die "Nicht genau abgetippt. Die Sitzung läuft weiter."
    fi
    end=$((now + 600))
    if [ "$end" -lt "$cur" ]; then
        printf '%s\n' "$end" > "$FOCUS_FILE"
    else
        end=$cur
    fi
    log "Notausstieg: Fokus-Sitzung endet um $(clock "$end") Uhr"
    echo "Okay. Die Sitzung endet um $(clock "$end") Uhr. Bis dahin gilt sie weiter."
    echo "Nutze die zehn Minuten: Schreib auf, warum du aussteigst."
}

wd_name() {
    case $1 in
        1) printf 'Mo' ;; 2) printf 'Di' ;; 3) printf 'Mi' ;; 4) printf 'Do' ;;
        5) printf 'Fr' ;; 6) printf 'Sa' ;; 7) printf 'So' ;; *) printf '  ' ;;
    esac
}

cmd_stats() {
    local i d day rest dow lab c bar k
    if [ ! -s "$STRIKES" ]; then
        echo "Noch kein einziger Ausrutscher aufgezeichnet."
        return 0
    fi
    echo "Ausrutscher der letzten 7 Tage"
    i=6
    while [ "$i" -ge 0 ]; do
        d=$(day_ago "$i" '+%Y-%m-%d|%u|%d.%m.')
        day=${d%%|*}
        rest=${d#*|}
        dow=${rest%%|*}
        lab=${rest#*|}
        c=$(grep -c "^$day" "$STRIKES" 2>/dev/null)
        is_int "$c" || c=0
        bar=""
        k=0
        while [ "$k" -lt "$c" ] && [ "$k" -lt 40 ]; do
            bar="$bar█"
            k=$((k + 1))
        done
        printf '  %s %s  %2s  %s\n' "$(wd_name "$dow")" "$lab" "$c" "$bar"
        i=$((i - 1))
    done
    echo
    echo "Häufigste Ablenkungen (alle Tage)"
    awk -F'|' 'NF >= 3 { c[$3]++ } END { for (k in c) printf "%d|%s\n", c[k], k }' "$STRIKES" |
        sort -t'|' -k1,1nr | head -n 5 |
        while IFS='|' read -r c k; do
            printf '  %3s×  %s\n' "$c" "$k"
        done
}

cmd_edit() {
    echo "Öffne den Ordner mit deinen Listen: $CONF_DIR"
    echo "  websites.txt        blockierte Websites"
    echo "  apps.txt            blockierte Programme"
    echo "  sprueche.txt        die Texte der Warnung"
